import { ScrollView } from "std-widgets.slint";
import { ActionButton } from "../components/controls.slint";

export component LyricsPage inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <string> text;
    in property <string> current-line;
    in property <string> status;
    in property <string> source;
    in property <bool> synchronized;
    callback refresh();
    background: #191F1B; border-radius: 24px;
    Text { x: 28px; y: 23px; text: "Текст песни"; color: #7BCE9A; font-size: 13px; }
    Text { x: 28px; y: 48px; width: parent.width - 235px; text: root.title; color: #F1F5F2; font-size: 24px; font-weight: 600; overflow: elide; }
    Text { x: 28px; y: 84px; width: parent.width - 56px; text: root.artist; color: #A4B0A8; font-size: 13px; overflow: elide; }
    ActionButton { x: parent.width - 174px; y: 35px; label: "Обновить"; glyph: "\u{e72c}"; clicked => { root.refresh(); } }
    if root.synchronized : Rectangle { x: 28px; y: 115px; width: parent.width - 56px; height: 80px; border-radius: 14px; background: #222B25;
        Text { x: 16px; y: 12px; width: parent.width - 32px; height: parent.height - 24px; text: root.current-line == "" ? "…" : root.current-line; color: #7BCE9A; font-size: 19px; font-weight: 600; wrap: word-wrap; vertical-alignment: center; }
    }
    ScrollView { x: 28px; y: root.synchronized ? 212px : 120px; width: root.width - 56px; height: root.height - self.y - 57px; viewport-width: self.width; viewport-height: max(self.height, body.preferred-height + 24px);
        body := Text { x: 4px; y: 4px; width: parent.width - 24px; text: root.text == "" ? root.status : root.text; color: root.text == "" ? #A4B0A8 : #F1F5F2; font-size: 17px; wrap: word-wrap; }
    }
    Text { x: 28px; y: parent.height - 39px; width: parent.width - 56px; text: root.source; color: #708077; font-size: 11px; overflow: elide; }
}
